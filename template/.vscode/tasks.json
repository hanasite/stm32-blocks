{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", ".\\build.bat"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [
        {
          "owner": "arm-gcc",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "pattern": {
            "regexp": "^(.+):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
            "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
          }
        }
      ],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Build and Flash",
      "dependsOn": "Build",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", ".\\flash.bat"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
