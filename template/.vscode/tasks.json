{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", ".\\build.bat"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Build and Flash",
      "dependsOn": "Build",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", ".\\flash.bat"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
